<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121314"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mobi-nooa"
            android:textColor="#00E5FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Autonomous Object-Oriented Mobile Agent Engine"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- API Key Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key (.env / Provider)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter API Key (nvapi-... / sk-...)"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:background="#1E1F20"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:inputType="text" />

        <!-- Provider Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Model Provider"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E1F20"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Model Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Model Name"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/modelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="meta/llama-3.3-70b-instruct"
            android:textColor="#FFFFFF"
            android:background="#1E1F20"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:inputType="text" />

        <!-- Agent Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agent Class"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/agentSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E1F20"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Task / Goal Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goal / Instruction"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/taskInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:text="Triage device battery, RAM headroom, and thermal health."
            android:textColor="#FFFFFF"
            android:background="#1E1F20"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:inputType="textMultiLine" />

        <!-- Execute Button -->
        <Button
            android:id="@+id/btnRunAgent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Execute Agent Task"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#00E5FF"
            android:layout_marginBottom="16dp" />

        <!-- Output & Status View -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Execution Console"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/outputView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="150dp"
            android:background="#1B1C1C"
            android:textColor="#00E5FF"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="Ready for execution.\nType API key and click 'Execute Agent Task'."
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
